# pgcli user config - only overrides; pgcli fills in its defaults for everything else.
# Unix: ~/.config/pgcli/config    Windows: %LOCALAPPDATA%\dbcli\pgcli\config
[main]
smart_completion = True
multi_line = True
multi_line_mode = psql
destructive_warning = all
keyword_casing = upper
table_format = psql
syntax_style = monokai
vi = False
less_chatty = True
timing = True
row_limit = 1000
expand = auto
null_string = (null)
on_error = STOP
enable_pager = True
