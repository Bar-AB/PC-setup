{
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:USERPROFILE\\.claude\\hooks\\claude-notify.ps1\"",
            "shell": "powershell",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$env:USERPROFILE\\.claude\\hooks\\claude-notify.ps1\" -DefaultTitle \"Claude Code\" -DefaultMessage \"Claude finished - ready for you\"",
            "shell": "powershell",
            "timeout": 15,
            "async": true
          }
        ]
      }
    ]
  }
}
