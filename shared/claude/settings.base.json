{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "model": "opus",
  "theme": "dark",
  "autoUpdatesChannel": "latest",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/id_*)",
      "Read(~/.pgpass)",
      "Read(~/.config/gh/hosts.yml)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(aws:*)",
      "Bash(psql:*)"
    ]
  },
  "enabledPlugins": {
    "codex@openai-codex": true,
    "cc10x@cc10x": true,
    "blast-radius@claude-code-mods": true,
    "context-bar@claude-code-mods": true,
    "where-am-i@claude-code-mods": true,
    "agent-radar@claude-code-mods": true,
    "usage-meter@claude-code-mods": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": { "source": "github", "repo": "openai/codex-plugin-cc" }
    },
    "cc10x": {
      "source": { "source": "github", "repo": "romiluz13/cc10x" }
    },
    "claude-code-mods": {
      "source": { "source": "github", "repo": "hamzafer/claude-code-mods" }
    }
  }
}
