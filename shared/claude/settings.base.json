{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.aws/credentials)",
      "Read(~/.ssh/id_*)",
      "Read(~/.pgpass)",
      "Read(~/.config/gh/hosts.yml)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(aws:*)",
      "Bash(psql:*)"
    ]
  }
}
